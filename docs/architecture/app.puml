@startuml
' Generated by scripts/architecture-map.mjs from architecture.config.mjs and
' the imports in src/. Do not edit by hand; run npm run architecture:map.
title Spacelords – kodkarta, nivå 2: App shell (src/client/app/)
skinparam packageStyle rectangle
skinparam shadowing false
left to right direction
note as about
  Master-controller, AppModel och AppView som binder ihop modulerna.
  Paket = fall. (delat) = filer direkt under lagret.
  Pilar mellan fall visar antal importer.
end note
package "(delat)" as app___delat_ {
  rectangle "<b>controllers</b>\nMasterController" as app___delat___controllers
  rectangle "<b>models</b>\nAppModel\nPlayerNotice" as app___delat___models
  rectangle "<b>views</b>\nAppView\nViewContracts\nplayerNoticeText" as app___delat___views
}
rectangle "boarding" as ext__boarding #EEEEEE
rectangle "common" as ext__common #EEEEEE
rectangle "space-battle" as ext__space_battle #EEEEEE
rectangle "space-map" as ext__space_map #EEEEEE
app___delat___controllers ..> app___delat___models : typer
app___delat___controllers ..> app___delat___views : typer
app___delat___views ..> app___delat___models : typer
app___delat_ --> ext__boarding : controllers, models, views
app___delat_ --> ext__common : HexCoordinate, dom
app___delat_ --> ext__space_battle : controllers, models, views
app___delat_ --> ext__space_map : controllers, models, views
@enduml
