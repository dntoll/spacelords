@startuml
' Generated by scripts/architecture-map.mjs from architecture.config.mjs and
' the imports in src/. Do not edit by hand; run npm run architecture:map.
title Spacelords – kodkarta, nivå 1: moduler och beroenden
skinparam packageStyle rectangle
skinparam shadowing false
package "src/client" {
  rectangle "main.ts\n<size:10>Startpunkt som skapar skal och kartvyer</size>" as main
  rectangle "App shell\napp/\n<size:10>Master-controller, AppModel och AppView som binder ihop modulerna.</size>" as app
  rectangle "Common\ncommon/\n<size:10>Generisk kod utan spelkunskap.</size>" as common
  rectangle "Space map\nspace-map/\n<size:10>Stjärnkartespelet: galax, ekonomi, flottor och turer.</size>" as space_map
  rectangle "Space battle\nspace-battle/\n<size:10>Den taktiska rymdstriden på hexrutnät.</size>" as space_battle
  rectangle "Boarding\nboarding/\n<size:10>Bordningsstriden inne i ett skepp och dess karteditor.</size>" as boarding
}
package "src/shared" {
  rectangle "Shared\n<size:10>Format som klient och server delar</size>" as shared
}
package "src/server" {
  rectangle "Server\n<size:10>Express, hälsokontroll och bordningskartornas API</size>" as server
}
app --> boarding : controllers, models, views
app --> common : HexCoordinate, dom
app --> space_battle : controllers, models, views
app --> space_map : controllers, models, views
boarding --> app : AppModel, ViewContracts, playerNoticeText
boarding --> common : dom
boarding --> shared : map-format
boarding ..> space_battle : models, typer
boarding --> space_map : views
main --> app : AppModel, AppView, MasterController
main --> boarding : models, views
main --> space_battle : views
main --> space_map : models, views
server --> shared : map-format
space_battle ..> app : AppModel, ViewContracts, typer
space_battle --> common : HexCoordinate, dom
space_battle --> space_map : models, views
space_map --> app : AppModel, PlayerNotice, ViewContracts
space_map --> boarding : models
space_map --> common : HexCoordinate, dom
space_map --> space_battle : models
legend right
  Pilar visar faktiska importer. Etiketten anger vilka index-filer
  (models, views, controllers) eller filer som används.
  Streckad pil: bara typimporter.
  Detaljer per modul: <modul>.puml i samma katalog.
endlegend
@enduml
