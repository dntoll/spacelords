@startuml
title Spacelords – problemdomän

class SaveSlot {
  number: 1..3
  lastPlayed
}
class SavedGame {
  version: 18
  round
  phase
  exploredSpace
  knownObjects
  surveyedPlanets
}
SaveSlot "1" o-- "0..1" SavedGame
SavedGame --> Galaxy
SavedGame --> Fleet
SavedGame --> Research
SavedGame --> GameEvent
SavedGame --> PirateFleet

class Galaxy {
  radius
  homePlanetId
  mapSnapshot()
}
note left of Galaxy
  Nya galaxer: radie 100, 150 system
  i tre diffusa spiralarmar.
  Spelet startar vid startplaneten.
  Planeter är platser; spelaren äger inga
  (single-fleet-rensning).
end note
class StarSystem
class Star {
  name
}
class Planet {
  name
  type: solid | gas
  environment: Temperate | Ice | Desert | Ocean | Toxic
  habitability
  resources
}
class TerrainHex {
  type: dense-asteroids | sparse-asteroids | nebula
  position
}
class Player {
  name
}
class HexCoordinate <<value object>> {
  q
  r
  neighbors()
  distanceTo()
}
Galaxy "1" o-- "1..*" StarSystem
Galaxy "1" --> "1" Player
Galaxy "1" --> "1" Planet : home planet
Galaxy "1" *-- "0..*" TerrainHex
StarSystem "1" *-- "1" Star
StarSystem "1" *-- "0..6" Planet
Star --> HexCoordinate : position
Planet --> HexCoordinate : position

class Technology {
  name: Missiles | Armor | Armored Transport | Armored Fighter
  prerequisites
}
class Research {
  completed
  queue
  progress
}
Player "1" *-- "1" Research
Research --> Technology : selects
Technology --> Technology : prerequisites
note right of Research
  flottforskning-av-tekniker (Ej implementerat):
  trädet och kön finns, men forskningen går inte
  framåt förrän forskningskapaciteten är beslutad.
end note

class Fleet {
  position : HexCoordinate [0..1]
  name
  courseOrigin
  destination
  ships: 0..*
}
note right of Fleet
  Order: Move och Stop, eller två tryck på en hex
  (hexval-med-vag). Fart per runda = långsammaste skeppet.
  resa-utan-synliga-pirater: utan synlig pirat
  börjar nästa runda direkt tills flottan är framme.
  Tom flotta saknar position.
  enda-spelarflottan (Ej implementerat):
  koden hanterar fortfarande en lista med flottor.
end note
class Ship {
  id
  type
  installedEngines
  installedTelescope: I | II | III [0..1]
  missiles: 0 | 2 [0..1]
  armored [0..1]
  speed
  crew
}
class Component {
  type: Rocket engine | Ion pulse engine | Weapons module | Telescope I | Telescope II | Telescope III
}
Fleet "1" o-- "0..*" Ship
Ship "1" *-- "1..3" Component : installed equipment
class Detection {
  currentVisibleHexes
  visiblePirateContacts
}
Detection --> Fleet : best installed telescope
note on link
  sikt-under-forflyttning:
  Synfältet följer visad position under rörelsen.
  Kartminnet behålls.
end note

class Discovery {
  kind: planet | star | pirate
  observerFleet
}
class TurnSimulation {
  remainingMovement
  awaitingCombat
  handling
}
SavedGame "1" o-- "0..1" TurnSimulation
TurnSimulation "1" o-- "0..*" Discovery
TurnSimulation --> Fleet : remaining movement
note right of TurnSimulation
  gemensamt-handelseflode:
  Visade händelser och aktiv hantering bevaras.
  Alla val från avbrottet avslutas före fortsatt simulering.
end note
class GameEvent {
  round
  text
  position : HexCoordinate [0..1]
}
class EventLine {
  text
  illustration: star | planet | ship | research
}
GameEvent "1" *-- "0..*" EventLine
GameEvent --> HexCoordinate : plats när händelsen inträffade
Discovery --> GameEvent : händelseidentitet

package "Framtida domän – ej implementerad" {
  class AsteroidBelt <<planned>>
  class Civilization <<planned>>
  Fleet --> Civilization : encounter orders
}

package "Kampanjbordning" {
  class BoardingEngagement {
    attackerId
    defenderId
    seenRound
    shift: boarding | space
  }
  class BoardingBattle {
    round
    initiativeOrder
    randomState
    reactorCountdown
    campaign
    abort()
    command()
  }
  class BoardingMap {
    terrain
    rooms: bridge | engineering | cockpit
    spawnPoints
    shipZones: attacker | bridge | defender
    lights
  }
  class Airlock {
    position: BoardingCell
    side: top | bottom
  }
  class Gangway {
    length: 6
    width: 2
  }
  note right of Airlock
    fast-airlock-i-bordningskarta:
    exakt en per skepp, i skrovets över- eller underkant.
    dockning-sida-vid-sida:
    anfallaren ovanför, försvararen under.
  end note
  BoardingMap "1" *-- "1..2" Airlock
  BoardingMap "1" *-- "0..1" Gangway
  Gangway --> "2" Airlock : förbinder
  class BoardingLight {
    position: BoardingCell
    height
    radius
    intensity
  }
  class BoardingPerson {
    side: player | defender | civilian
    position: BoardingCell
    facing: eight directions
    crouched
    hitPoints
    actionPoints
    carriedActionPoints
    destination: BoardingCell
    cockpit
    heardAt: BoardingCell
    status: active | incapacitated | dead | evacuated
  }
  class BoardingFeature {
    kind: door | wall | reactor | cover | exit | thin-wall
    position: BoardingCell
    axis: q | r
    low
    hitPoints
    open
    locked
  }
  note right of BoardingFeature
    tunna-innervaggar:
    Q och R är 1/3 m innerväggar på golv.
    halvhog-tunn-vagg:
    q och r är 1,2 m, ger Half cover och fälls inte.
    sammanfogade-tunna-vaggar:
    formen följer grannarnas väggar och dörrar.
    fonster-pa-halvhog-vagg / helhogt-fonster:
    glas till taket; krossas av skott (shattered).
  end note
  class BoardingKnowledge {
    visibleCells
    exploredCells
    lastKnownEnemies
    noiseMarkers
  }
  class BoardingCell {
    column
    row
  }
  BoardingEngagement *-- BoardingBattle
  BoardingBattle *-- BoardingMap
  class BoardingActivation {
    id
    remaining
  }
  BoardingBattle *-- BoardingActivation
  note right of BoardingActivation
    automatisk-bordningstur-vid-tom-ap:
    AP noll avslutar aktiveringen efter handlingens utfall.
    Tidigare uppskjutna soldater behåller återstående AP.
  end note
  BoardingBattle *-- BoardingPerson
  BoardingBattle *-- BoardingFeature
  BoardingBattle *-- BoardingKnowledge
  BoardingMap *-- BoardingLight
  BoardingLight --> BoardingCell
  BoardingMap --> BoardingCell
  note right of BoardingMap
    formbar-skeppskontur:
    Tom rymd saknar terrängruta; skrov markerar skeppets kant.
  end note
  note right of BoardingCell
    meterskala-i-bordning:
    En golvruta motsvarar 1 × 1 meter.
    Visuell höjd och skymning hör till vylagret.
  end note
}

note "Kamera, controllers och p5-vyer är tekniska begrepp\noch ingår inte i problemdomänen." as Scope

class PirateFleet {
  id
  systemId
  position : HexCoordinate
  count
  transports
  hold
  nextPosition()
}
class TacticalBattle {
  largeShipFootprints
  escapeZones
  maneuverSystem
  phase: deployment | fighting | complete
  round
  turn
  randomState
  dockedPairs
  command()
  actAutomatically(singleStep)
}
class BattlePiece {
  position: HexCoordinate
  facing
  hull
  missiles
  movement
  speed
  dockedWith
  escapeEdge: top | bottom [0..1]
  status: active | wreck | destroyed | escaped
  activated
  overwatch: WeaponName [0..1]
  firedRound: number [0..1]
}
class ShipFootprint {
  cells()
  length()
  contains()
}
BattlePiece ..> ShipFootprint : skrovets upptagna hex
TacticalBattle ..> ShipFootprint : placering, rörelse och träffyta
class BattleActivation {
  remainingMovement
  fired
  movementClosed
}
note right of BattleActivation
  skeppsval-startar-stridstur:
  automatiskt-skeppsval-i-strid väljer och aktiverar
  ett oanvänt eget skepp när spelarsidan får turen.
  Skeppet spelar klart innan nästa kan väljas.
end note
note left of BattlePiece
  flyktzoner-i-rymdstrid:
  ett stort skepp är aktivt och beskjutbart
  tills hela skrovet har lämnat Escape-zonen.
end note
class Weapon {
  range
  firingArc
  dice
  hitThreshold
}
class BattleAsteroid
TurnSimulation "1" *-- "0..*" TacticalBattle : ordered encounters
TurnSimulation "1" *-- "0..1" BoardingEngagement
TacticalBattle --> BoardingEngagement : dock then shift
TacticalBattle "1" *-- "1..*" BattlePiece
TacticalBattle "1" *-- "0..1" BattleActivation
TacticalBattle "1" *-- "0..*" BattleAsteroid
BattlePiece --> Fleet : origin and retreat destination
BattlePiece --> "0..1" Ship : strategic identity
BattlePiece --> Weapon : fixed by ship type
TacticalBattle --> HexCoordinate : distinct tactical map
BattleReport --> Fleet : participating fleets
SavedGame --> PirateFleet
StarSystem "1" <-- "0..*" PirateFleet : patrols
TacticalBattle --> Fleet
TacticalBattle --> PirateFleet
TacticalBattle --> GameEvent : combat outcome
class BattleReport {
  position
  losses
  survivors
}
TacticalBattle --> BattleReport
SavedGame --> BattleReport
BattleReport --> GameEvent : händelseidentitet
class BattleShot {
  weapon
  from
  at
  impacts
}
TacticalBattle "1" *-- "0..1" BattleShot : senaste salvan
@enduml
